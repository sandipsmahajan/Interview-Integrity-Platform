# ---------------------------------------------------------------------------
# Integrity Pro - example environment file
#
# Copy to .env and adjust for the target runtime. This file documents every
# configuration key the platform reads (see the per-service
# src/main/resources/application.yml for the authoritative defaults).
#
#   cp infra/config/.env.example .env
#
# Docker Compose:  docker compose --env-file .env -f infra/docker/docker-compose.yml up
# Kubernetes:      values are rendered into ConfigMaps/Secrets by the Helm chart
#                  (infra/helm/interview-integrity) from these same names.
# ---------------------------------------------------------------------------

# --- Spring profiles --------------------------------------------------------
# local | docker | kubernetes | dev | qa | uat | prod
SPRING_PROFILES_ACTIVE=local
# Directory containing the application-<profile>.yml files
SPRING_CONFIG_LOCATION=infra/config/

# --- Database (PostgreSQL) --------------------------------------------------
# DB_HOST: localhost | postgres | postgres.integrity.svc.cluster.local | <RDS endpoint>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USERNAME=integrity
DB_PASSWORD=integrity
DB_POOL_INITIAL_SIZE=4
DB_POOL_MAX_SIZE=16

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ------------------------------------------------------------------
# local:  localhost:9092 | docker: kafka:9092
# k8s:    kafka-kafka-bootstrap.kafka.svc.cluster.local:9092
# prod:   <MSK bootstrap brokers, comma-separated>
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PRODUCER_ACKS=all
KAFKA_CONSUMER_GROUP_ID=default

# --- Eureka (service registry) ----------------------------------------------
EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_REGISTER_WITH_EUREKA=true
EUREKA_FETCH_REGISTRY=true

# --- Mail (SMTP) ------------------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@integritypro.app
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_BASE_DELAY=1m
MAIL_WORKER_INTERVAL=30s

# --- Security / JWT ---------------------------------------------------------
JWT_SECRET=local-development-change-me-32-bytes-minimum
JWT_ISSUER=interview-integrity
JWT_AUDIENCE=interview-integrity-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_PERMIT_ALL=/actuator/health/readiness,/actuator/health/liveness,/actuator/info
JWT_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Identity / auth behaviour ----------------------------------------------
APP_NAME=Integrity Pro
FRONTEND_BASE_URL=http://localhost:5173
MFA_CHALLENGE_TTL=PT5M
MFA_EMAIL_PURPOSE=mfa-login
EXPOSE_RESET_TOKEN=false
RESET_REQUEST_INTERVAL=PT1M
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT=PT15M
MAX_MFA_CHALLENGE_ATTEMPTS=5

# --- Gateway / desktop client ------------------------------------------------
GATEWAY_DISCOVERY_LOCATOR_ENABLED=false
DESKTOP_RELAY_TOPICS=desktop-client-events.v1

# --- Platform ----------------------------------------------------------------
APP_TIMEZONE=UTC
SERVER_PORT=8080

# --- Object storage (S3-compatible) ------------------------------------------
# local/docker/k8s: http://localhost:9000 | http://minio:9000 |
#                   http://minio.integrity.svc.cluster.local:9000
# qa/uat/prod:      https://s3.<region>.amazonaws.com (default in profile)
PLATFORM_STORAGE_ENDPOINT=http://localhost:9000
PLATFORM_STORAGE_REGION=us-east-1
