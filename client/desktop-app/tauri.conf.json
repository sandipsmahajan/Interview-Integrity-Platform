{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Integrity Pro",
  "version": "0.1.0",
  "identifier": "com.integritypro.desktop",
  "build": {
    "frontendDist": "web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cd web && npm run dev",
    "beforeBuildCommand": "cd web && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Integrity Pro",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://teams.microsoft.com https://meet.google.com https://zoom.us https://*.zoom.us https://daily.co https://*.daily.co https://livekit.io https://*.livekit.io; connect-src 'self' http://localhost:* https://* ws://localhost:* wss://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon-256.png",
      "icons/icon-128.png",
      "icons/icon-32.png"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
