<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Spring Data R2DBC and JSON serialization read entity fields reflectively. -->
  <Match>
    <BugCode name="UrF" />
  </Match>
  <!-- Java records expose their components through accessors; EI/EI2 are not applicable. -->
  <Match>
    <BugCode name="EI" />
  </Match>
  <Match>
    <BugCode name="EI2" />
  </Match>
  <!-- Read-only reference entities are populated by SQL reference data via R2DBC reflection. -->
  <Match>
    <BugCode name="UwF" />
  </Match>
</FindBugsFilter>
