# Force LF line endings for shell scripts and the Gradle wrapper so they run
# correctly inside Linux Docker build stages when checked out on Windows.
gradlew text eol=lf
gradlew.bat text eol=crlf
*.sh text eol=lf
*.gradle.kts text eol=lf
*.gradle text eol=lf
*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.md text eol=lf
